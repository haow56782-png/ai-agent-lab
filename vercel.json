{
  "buildCommand": "npx tsc",
  "functions": {
    "dist/api/index.js": {
      "memory": 256,
      "maxDuration": 30,
      "includeFiles": "dist/**"
    }
  },
  "routes": [
    { "src": "/health", "dest": "/dist/api/index.js" },
    { "src": "/api/(.*)", "dest": "/dist/api/index.js" },
    { "src": "/(.*)", "dest": "/dist/api/index.js" }
  ]
}

{
  "name": "vib-ai-agent",
  "version": "1.0.0",
  "private": true,
  "description": "VIB AI Agent Platform — AI-driven game prediction platform",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "vib-flow-demo": "STATE_STORE_ENABLED=true tsx src/index.ts vib-flow-demo",
    "start": "node dist/index.js",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate:agent-os-skills": "node scripts/validate-agent-os-skills.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "dotenv": "^16.4.7",
    "openai": "^4.86.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}

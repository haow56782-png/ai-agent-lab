{
  "buildCommand": "cd services/client && npm install && npm run vercel-build",
  "outputDirectory": "services/client/dist",
  "installCommand": "",
  "functions": {
    "api/index.js": {
      "memory": 256,
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.js" },
    { "src": "/health", "dest": "api/index.js" }
  ]
}

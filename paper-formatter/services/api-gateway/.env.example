PORT=4000
NODE_ENV=development

# ── Required ──
DATABASE_URL=postgresql://paper:paper@localhost:5432/paper_formatter
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ── Optional ──
# REDIS_URL=redis://localhost:6379
#   When set and reachable: profile/detect/school caches use Redis.
#   When omitted or unreachable: falls back to in-memory cache (cache miss is acceptable).
#   Can be removed entirely for Railway cost savings — api-gateway starts without it.

DEFAULT_MODEL_PROVIDER=deepseek
DEFAULT_EXECUTION_MODEL=DeepSeek v4
DEFAULT_EXECUTION_PERMISSION_MODE=default
